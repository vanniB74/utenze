# =============================================================================
#  C.S.I. Front Office — Variabili ambiente (template)
#  Copia in .env e riempi i valori reali. NON committare .env nel repo.
# =============================================================================

# --- Avvio server ---------------------------------------------------------
# Porta HTTP del server Node (default 3000).
PORT=3000
# Host bind (0.0.0.0 in container, 127.0.0.1 in dev locale).
HOST=0.0.0.0
# Ambiente: production abilita cookie Secure; development disabilita.
NODE_ENV=production

# --- Database (SQLite locale) --------------------------------------------
# Default: file SQLite su volume persistente. In produzione su container,
# monta /data come volume persistent.
DATABASE_URL=file:/data/crm.sqlite

# --- URL pubblico del deployment (per QR operatori) -----------------------
# OBBLIGATORIO per il flusso QR: l'URL embedded nel QR deve puntare alla
# pagina /operator/:token pubblicamente raggiungibile dal telefono.
# Esempi: https://crm.tuo-dominio.it, https://csi-crm.up.railway.app
NEXT_PUBLIC_SITE_URL=https://crm.tuo-dominio.it

# --- Auth Master (3FA) ---------------------------------------------------
# TTL della sessione master in minuti (default 480 = 8 ore).
SESSION_TTL_MINUTES=480
# TTL dell'OTP in minuti (default 15).
OTP_TTL_MINUTES=15

# --- SMTP (invio OTP via email) ------------------------------------------
# Se SMTP_HOST non è impostato, l'OTP NON viene inviato via email.
# In test, con CSI_TEST_SEED=1, l'OTP è loggato a stderr.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=il-tuo-account@gmail.com
SMTP_PASS=la-tua-app-password-16-char
SMTP_FROM=il-tuo-account@gmail.com

# --- Backup cifrato AES-256-GCM su più dischi ----------------------------
# CSV di directory (deve essere scrivibile dal processo).
# Es: /data/backups/primary,/mnt/nas/csi-backups
CSI_BACKUP_DIRS=/data/backups/primary
# Chiave AES a 32 byte in hex (64 char). Genera con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CSI_BACKUP_KEY=

# --- Dati dell'ente (per i contratti) ------------------------------------
# Tutti null di default. L'admin li configura al primo setup, oppure li
# precompila qui per evitare l'inserimento manuale.
CSI_ENTE_NAME=C.S.I. — Centro Servizi Integrati
CSI_ENTE_REP=
CSI_ENTE_ADDR=
CSI_ENTE_CITY=
CSI_ENTE_CF=
CSI_ENTE_PATRONATO=

# --- Seed (dati dimostrativi, SOLO per test) ------------------------------
# Attiva lo script scripts/seed.js (crea record con is_test=1).
# MAI mettere a 1 in produzione.
CSI_TEST_SEED=0
